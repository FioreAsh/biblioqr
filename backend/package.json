{
  "name": "biblioqr-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "API REST de BiblioQR: catálogo, reservas con QR, préstamos, devoluciones, sanciones y auditoría.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "reset": "node src/db/migrate.js --reset && node src/db/seed.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "express": "^4.22.3",
    "pg": "^8.23.1"
  }
}
