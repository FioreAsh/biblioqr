# Copia este archivo como .env y ajusta los valores.

PORT=3000

# PostgreSQL real. Si lo dejas vacío se usa PGlite (PostgreSQL embebido en backend/data/pglite).
# DATABASE_URL=postgres://usuario:clave@localhost:5432/biblioqr

# Solo los correos de este dominio pueden registrarse solos como estudiantes.
DOMINIO_INSTITUCIONAL=aula.edu.pe

# 1 = enlace público de demostración: entrar con un clic por rol, códigos en pantalla y botón para reiniciar datos.
# MODO_DEMO=1

# Secreto para firmar los códigos de verificación. ¡Cámbialo en producción!
APP_SECRET=cambia-este-secreto-en-produccion

# 1 = la API devuelve el código de verificación en la respuesta (solo para desarrollo).
# En producción (NODE_ENV=production) queda desactivado por defecto.
# MOSTRAR_CODIGO_DEV=1

# Correo saliente (opcional). Sin SMTP_HOST, los correos se imprimen en la consola.
# Requiere: npm install nodemailer
# SMTP_HOST=smtp.tu-institucion.edu.pe
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=BiblioQR <no-responder@biblioteca.edu.pe>

# Zona horaria para las fechas de los correos
# TZ_BIBLIOTECA=America/Lima
